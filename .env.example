# Copy this file to .env and fill it in. Never share .env.

USER_NAME=sir
CITY=London

# ---- Brain ----
OLLAMA_MODEL=gpt-oss:20b
# auto = use API key if set, otherwise your Claude subscription (Claude Code). off = local only.
CLAUDE_MODE=auto
# Optional, add later for faster answers (https://platform.claude.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Voice ----
VOICE=bm_george
WAKE_WORD=jarvis

# ---- Tapo (same email + password as the Tapo app) ----
TAPO_EMAIL=
TAPO_PASSWORD=
# name=IP pairs, comma separated. Find IPs in Tapo app > device > settings > device info
TAPO_DEVICES=bedroom=192.168.1.50,desk lamp=192.168.1.51

# ---- Home & routine ----
HOME_POSTCODE=
DAILY_HABITS=gym,job applications,study,read a book,ten thousand steps
FOLLOW_UP_SECONDS=5
